{
  "name": "patchwork",
  "displayName": "patchwork",
  "version": "0.0.1",
  "description": "",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "rspack",
    "watch": "rspack --watch",
    "package": "rspack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vscode-test"
  },
  "dependencies": {
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/ai": "^0.69.0",
    "@tanstack/ai-anthropic": "^0.22.0",
    "@tanstack/ai-openai": "^0.30.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "clsx": "^2.1.1",
    "effect": "^4.0.3",
    "postcss": "^8.5.29",
    "postcss-loader": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "contributes": {
    "commands": [
      {
        "command": "patchwork.openCommitComposer",
        "title": "Open Commit Composer",
        "icon": "$(git-commit)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "patchwork.openCommitComposer",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.140.0"
  }
}
