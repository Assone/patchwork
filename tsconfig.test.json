{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "rootDir": "./src",
    "outDir": "./out",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "types": ["node", "mocha"]
  },
  "include": ["src/test/**/*.ts"],
  "exclude": ["node_modules", "dist", "out"]
}
