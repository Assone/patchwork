{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "rootDir": "./src",
    "outDir": "./out",
    "noEmit": false,
    "module": "CommonJS",
    "verbatimModuleSyntax": false,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": false,
    "moduleDetection": "auto",
    "types": ["node", "mocha"],
    // `src/webview/utils` is compiled here (diffRows etc. are tested
    // directly), and its `vscode.ts` ambient declarations reference
    // `Transferable` from the DOM lib.
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    // Vitest compiles and runs unit tests directly. This project only
    // emits the tests that need the VS Code extension host.
    "src/test/**/*.integration.test.ts",
    "src/test/helpers",
    "src/rpc",
    "src/services",
    "src/infrastructure",
    "src/features",
    "src/domain"
  ],
  "exclude": ["node_modules", "dist", "out"]
}
